{
  "name": "bbvs-backend",
  "version": "2.0.0",
  "private": true,
  "description": "API server for the blockchain-based e-voting system",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "ts-node src/index.ts",
    "dev": "nodemon src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js",
    "migrate": "npm run typeorm -- migration:run",
    "seed:admin": "ts-node src/scripts/seed-admin.ts",
    "gen:secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql": "^2.18.1",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.2.45",
    "web3": "^1.10.4",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^18.19.0",
    "@types/supertest": "^6.0.2",
    "ganache": "^7.9.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "solc": "0.8.11",
    "sql.js": "^1.10.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  }
}
