# Copy this file to .env and fill it in. .env is git-ignored; never commit it.
# Generate each secret with:  npm run gen:secret

# --- secrets (all three must be different, 32+ characters) ---
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# Salts the voter ids written to the blockchain. Keep it secret and never change it
# mid-election, or people could vote twice.
VOTER_HASH_SALT=

# --- database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=bbvs
DB_PASSWORD=
DB_NAME=bbvs

# --- blockchain (Ganache default) ---
CHAIN_RPC_URL=http://127.0.0.1:7545
# Optional. Leave empty to use the address that `truffle migrate` wrote to build/contracts/Election.json
CONTRACT_ADDRESS=
# Optional. Leave empty to use the node's first account (the one that deployed the contract).
CHAIN_FROM_ADDRESS=

# --- server ---
PORT=8000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
# Set to 1 when running behind one reverse proxy (needed for correct rate limiting)
TRUST_PROXY=0

# --- first admin (used only by `npm run seed:admin`; remove ADMIN_PASSWORD afterwards) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_CITIZENSHIP_NUMBER=
